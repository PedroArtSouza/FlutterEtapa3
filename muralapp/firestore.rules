rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function dono(uid) { return autenticado() && request.auth.uid == uid; }

    match /usuarios/{uid} {
      allow read, create, update: if dono(uid);
      allow delete: if false;
    }

    match /publicacoes/{publicacaoId} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.autorId == request.auth.uid;
      allow delete: if dono(resource.data.autorId);
      allow update: if false;

      match /comentarios/{comentarioId} {
        allow read: if autenticado();
        allow create: if autenticado()
          && exists(/databases/$(database)/documents/publicacoes/$(publicacaoId))
          && request.resource.data.keys().hasOnly([
            'texto', 'autorNome', 'autorId', 'publicacaoId', 'data'
          ])
          && request.resource.data.keys().hasAll([
            'texto', 'autorNome', 'autorId', 'publicacaoId', 'data'
          ])
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.publicacaoId == publicacaoId
          && request.resource.data.autorNome is string
          && request.resource.data.autorNome.size() > 0
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500
          && request.resource.data.data == request.time;
        allow delete: if dono(resource.data.autorId);
        allow update: if false;
      }
    }
  }
}
